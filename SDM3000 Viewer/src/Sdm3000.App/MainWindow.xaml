<Window
	x:Class="Sdm3000.App.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Sdm3000.App"
	xmlns:sharedControls="clr-namespace:LabStation.UI.Controls;assembly=LabStation.UI"
	Title="Siglent SDM3000 Control"
	Width="920"
	Height="318"
	Icon="/Siglent.SDM3000.Control;component/Assets/Siglent_SDM3055.ico"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen">
	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Narzędzia">
				<MenuItem
					x:Name="ScanNetworkMenuItem"
					Header="Skanuj sieć"
					Click="ScanNetworkClick" />
				<Separator />
				<MenuItem
					x:Name="AutoConnectMenuItem"
					Header="Auto connect"
					IsCheckable="True"
					Click="AutoConnectClick" />
			</MenuItem>
			<MenuItem x:Name="SaveAsMenuItem" Header="Zapisz jako">
				<MenuItem
					x:Name="SaveCsvMenuItem"
					Header="CSV"
					Click="SaveCsvClick" />
			</MenuItem>
			<sharedControls:AboutMenuItem Presentation="{x:Static local:AppInformation.Presentation}" />
		</Menu>
		<local:MultimeterView x:Name="InstrumentPanel" />
	</DockPanel>
</Window>
