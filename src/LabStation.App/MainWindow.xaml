<Window
	x:Class="LabStation.App.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:LabStation.UI.Controls;assembly=LabStation.UI"
	xmlns:local="clr-namespace:LabStation.App"
	xmlns:korad="clr-namespace:LabStation.App.Korad"
	xmlns:scope="clr-namespace:Scope.App;assembly=Siglent.SDS1000CML.Viewer"
	xmlns:generator="clr-namespace:Sdg1032X.App;assembly=Siglent.SDG1000X.Control"
	xmlns:multimeter="clr-namespace:Sdm3000.App;assembly=Siglent.SDM3000.Control"
	xmlns:load="clr-namespace:Sdl1000X.App;assembly=Siglent.SDL1000X.Control"
	Title="LabStation"
	Background="{StaticResource LabStationBackgroundBrush}"
	Foreground="{StaticResource LabStationTextBrush}"
	WindowState="Maximized"
	ResizeMode="CanMinimize"
	WindowStartupLocation="CenterScreen">
	<DockPanel LastChildFill="True">
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Korad">
				<MenuItem Header="Konfiguracja">
					<MenuItem
						x:Name="KoradOneSingleMenuItem"
						Header="1 Single"
						IsCheckable="True"
						Click="KoradOneSingleClick" />
					<MenuItem
						x:Name="KoradTwoSingleMenuItem"
						Header="2 Single"
						IsCheckable="True"
						Click="KoradTwoSingleClick" />
					<MenuItem
						x:Name="KoradDualMenuItem"
						Header="Dual"
						IsCheckable="True"
						Click="KoradDualClick" />
				</MenuItem>
				<Separator />
				<MenuItem Header="Zapisz jako">
					<MenuItem Header="Napięcie CSV" Click="KoradSaveVoltageClick" />
					<MenuItem Header="Prąd CSV" Click="KoradSaveCurrentClick" />
					<MenuItem Header="Napięcie i prąd CSV" Click="KoradSaveBothClick" />
				</MenuItem>
			</MenuItem>
			<MenuItem Header="Oscyloskop">
				<MenuItem x:Name="ScopeScanMenuItem" Header="Skanuj sieć" Click="ScopeScanClick" />
				<MenuItem x:Name="ScopeAutoConnectMenuItem" Header="Auto connect" IsCheckable="True" Click="ScopeAutoConnectClick" />
				<Separator />
				<MenuItem Header="Zapisz jako">
					<MenuItem x:Name="ScopeSaveChannel1MenuItem" Header="CH1 CSV" Click="ScopeSaveChannel1Click" />
					<MenuItem x:Name="ScopeSaveChannel2MenuItem" Header="CH2 CSV" Click="ScopeSaveChannel2Click" />
					<MenuItem x:Name="ScopeSaveBothMenuItem" Header="CH1 i CH2 CSV" Click="ScopeSaveBothClick" />
				</MenuItem>
			</MenuItem>
			<MenuItem Header="Generator">
				<MenuItem x:Name="GeneratorScanMenuItem" Header="Skanuj sieć" Click="GeneratorScanClick" />
				<MenuItem x:Name="GeneratorAutoConnectMenuItem" Header="Auto connect" IsCheckable="True" Click="GeneratorAutoConnectClick" />
			</MenuItem>
			<MenuItem Header="Multimetr">
				<MenuItem x:Name="MultimeterScanMenuItem" Header="Skanuj sieć" Click="MultimeterScanClick" />
				<MenuItem x:Name="MultimeterAutoConnectMenuItem" Header="Auto connect" IsCheckable="True" Click="MultimeterAutoConnectClick" />
				<Separator />
				<MenuItem x:Name="MultimeterSaveMenuItem" Header="Zapisz pomiar CSV" Click="MultimeterSaveClick" />
			</MenuItem>
			<MenuItem Header="Obciążenie">
				<MenuItem x:Name="LoadScanMenuItem" Header="Skanuj sieć" Click="LoadScanClick" />
				<MenuItem x:Name="LoadAutoConnectMenuItem" Header="Auto connect" IsCheckable="True" Click="LoadAutoConnectClick" />
			</MenuItem>
			<controls:AboutMenuItem Presentation="{x:Static local:AppInformation.Presentation}" />
		</Menu>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="32*" />
				<RowDefinition Height="68*" />
			</Grid.RowDefinitions>
			<Border BorderBrush="#3F3F3F" BorderThickness="1">
				<korad:KoradPanel x:Name="KoradInstrumentPanel" />
			</Border>
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="53*" />
					<ColumnDefinition Width="18*" />
					<ColumnDefinition Width="29*" />
				</Grid.ColumnDefinitions>
				<Border BorderBrush="#3F3F3F" BorderThickness="1,0,1,1">
					<scope:OscilloscopeView x:Name="OscilloscopeInstrumentPanel" />
				</Border>
				<Border Grid.Column="1" BorderBrush="#3F3F3F" BorderThickness="0,0,1,1">
					<generator:GeneratorView x:Name="GeneratorInstrumentPanel" />
				</Border>
				<Grid Grid.Column="2">
					<Grid.RowDefinitions>
						<RowDefinition Height="40*" />
						<RowDefinition Height="60*" />
					</Grid.RowDefinitions>
					<Border BorderBrush="#3F3F3F" BorderThickness="0,0,1,1">
						<multimeter:MultimeterView x:Name="MultimeterInstrumentPanel" />
					</Border>
					<Border Grid.Row="1" BorderBrush="#3F3F3F" BorderThickness="0,0,1,1">
						<load:ElectronicLoadView x:Name="LoadInstrumentPanel" />
					</Border>
				</Grid>
			</Grid>
		</Grid>
	</DockPanel>
</Window>
