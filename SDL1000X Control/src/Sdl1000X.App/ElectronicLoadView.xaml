<UserControl
	x:Class="Sdl1000X.App.ElectronicLoadView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sharedControls="clr-namespace:LabStation.UI.Controls;assembly=LabStation.UI"
	Background="{DynamicResource LabStationBackgroundBrush}"
	Foreground="{DynamicResource LabStationTextBrush}">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/LabStation.UI;component/Themes/LabStationTheme.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid VerticalAlignment="Center">
		<Grid.RowDefinitions>
			<RowDefinition Height="40" />
			<RowDefinition Height="75" />
			<RowDefinition Height="34" />
			<RowDefinition Height="105" />
			<RowDefinition Height="100" />
			<RowDefinition Height="25" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="8,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Text="IP:" />
			<TextBox x:Name="HostEditor" Grid.Column="1" Width="150" Height="28" />
			<Button
				x:Name="ConnectionButton"
				Grid.Column="2"
				Width="78"
				Margin="8,0,0,0"
				Click="ConnectionClick"
				Content="Offline" />
			<Button
				x:Name="InputButton"
				Grid.Column="4"
				Width="78"
				Click="InputClick"
				Content="OFF" />
		</Grid>

		<Border Grid.Row="1" Margin="8,0" Background="#252525" BorderBrush="#3F3F3F" BorderThickness="1">
			<UniformGrid Columns="4">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Napięcie" />
					<StackPanel Orientation="Horizontal">
						<TextBlock x:Name="VoltageValueText" FontFamily="Consolas" FontSize="20" Text="0,000" />
						<TextBlock Margin="4,0,0,0" VerticalAlignment="Bottom" Foreground="#FF00FFFF" Text="V" />
					</StackPanel>
				</StackPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Prąd" />
					<StackPanel Orientation="Horizontal">
						<TextBlock x:Name="CurrentValueText" FontFamily="Consolas" FontSize="20" Text="0,000" />
						<TextBlock Margin="4,0,0,0" VerticalAlignment="Bottom" Foreground="#FFFFD700" Text="A" />
					</StackPanel>
				</StackPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Moc" />
					<StackPanel Orientation="Horizontal">
						<TextBlock x:Name="PowerValueText" FontFamily="Consolas" FontSize="20" Text="0,00" />
						<TextBlock Margin="4,0,0,0" VerticalAlignment="Bottom" Foreground="#FFFF8C00" Text="W" />
					</StackPanel>
				</StackPanel>
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock HorizontalAlignment="Center" FontSize="11" Text="Rezystancja" />
					<StackPanel Orientation="Horizontal">
						<TextBlock x:Name="ResistanceValueText" FontFamily="Consolas" FontSize="20" Text="0,000" />
						<TextBlock Margin="4,0,0,0" VerticalAlignment="Bottom" Foreground="#FF50E650" Text="Ω" />
					</StackPanel>
				</StackPanel>
			</UniformGrid>
		</Border>

		<UniformGrid x:Name="ModeButtons" Grid.Row="2" Margin="8,3" Columns="5">
			<Button Margin="1,0" Click="ModeClick" Content="CC" Tag="ConstantCurrent" />
			<Button Margin="1,0" Click="ModeClick" Content="CV" Tag="ConstantVoltage" />
			<Button Margin="1,0" Click="ModeClick" Content="CP" Tag="ConstantPower" />
			<Button Margin="1,0" Click="ModeClick" Content="CR" Tag="ConstantResistance" />
			<Button Margin="1,0" Click="ModeClick" Content="LED" Tag="Led" />
		</UniformGrid>

		<Border Grid.Row="3" Margin="8,2" Background="#696969" BorderBrush="#303030" BorderThickness="1" Padding="8,2">
			<Grid>
				<sharedControls:NumericValueEditor
					x:Name="SetpointEditor"
					Label="Nastawa CC"
					Unit="A"
					Minimum="0"
					Maximum="30"
					Step="0.001"
					DecimalPlaces="3"
					ValueCommitted="SetpointCommitted" />
				<UniformGrid x:Name="LedSettingsPanel" Columns="3" Visibility="Collapsed">
					<sharedControls:NumericValueEditor
						x:Name="LedVoltageEditor"
						Margin="0,0,4,0"
						Label="Vo"
						Unit="V"
						Maximum="150"
						Step="0.001"
						DecimalPlaces="3"
						ValueCommitted="LedSettingCommitted" />
					<sharedControls:NumericValueEditor
						x:Name="LedCurrentEditor"
						Margin="2,0"
						Label="Io"
						Unit="A"
						Maximum="30"
						Step="0.001"
						DecimalPlaces="3"
						ValueCommitted="LedSettingCommitted" />
					<sharedControls:NumericValueEditor
						x:Name="LedResistanceEditor"
						Margin="4,0,0,0"
						Label="Rco"
						Unit="Ω"
						Minimum="0.03"
						Maximum="10000"
						Step="0.001"
						DecimalPlaces="3"
						ValueCommitted="LedSettingCommitted" />
				</UniformGrid>
			</Grid>
		</Border>

		<Grid Grid.Row="4" Margin="8,2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="2*" />
			</Grid.ColumnDefinitions>
			<Grid Grid.Column="0" Margin="0,0,3,0">
				<sharedControls:NumericValueEditor
					x:Name="OverCurrentEditor"
					Label="OCP"
					Unit="A"
					Maximum="31"
					Step="0.001"
					DecimalPlaces="3"
					ValueCommitted="ProtectionCommitted" />
				<CheckBox
					x:Name="OverCurrentEnabled"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Click="ProtectionStateClick"
					ToolTip="Włącz zabezpieczenie nadprądowe" />
			</Grid>
			<Grid Grid.Column="1" Margin="3,0">
				<sharedControls:NumericValueEditor
					x:Name="OverPowerEditor"
					Label="OPP"
					Unit="W"
					Maximum="210"
					Step="0.01"
					DecimalPlaces="2"
					ValueCommitted="ProtectionCommitted" />
				<CheckBox
					x:Name="OverPowerEnabled"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Click="ProtectionStateClick"
					ToolTip="Włącz zabezpieczenie nadmocowe" />
			</Grid>
			<Border Grid.Column="2" Margin="3,5" Background="#898989" BorderBrush="#303030" BorderThickness="1" ToolTip="Sprzętowy próg OVP modelu SDL1020X-E">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="OVP" />
					<TextBlock x:Name="OverVoltageText" FontFamily="Consolas" FontSize="17" Text="155 V" />
				</StackPanel>
			</Border>
			<Border Grid.Column="3" Margin="3,5,0,5" Background="#898989" BorderBrush="#303030" BorderThickness="1" ToolTip="Sprzętowy próg OTP modelu SDL1020X-E">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="OTP" />
					<TextBlock x:Name="OverTemperatureText" FontFamily="Consolas" FontSize="17" Text="85 °C" />
				</StackPanel>
			</Border>
		</Grid>

		<Border Grid.Row="5" Style="{StaticResource LabStationStatusPanelStyle}">
			<TextBlock x:Name="StatusText" Style="{StaticResource LabStationStatusTextStyle}" Text="Status: OFFLINE" />
		</Border>
	</Grid>
</UserControl>
