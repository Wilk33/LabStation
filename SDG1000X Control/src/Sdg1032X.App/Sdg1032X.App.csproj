<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType Condition="'$(LabStationEmbed)' != 'true'">WinExe</OutputType>
		<OutputType Condition="'$(LabStationEmbed)' == 'true'">Library</OutputType>
		<UseWPF>true</UseWPF>
		<AssemblyName>Siglent.SDG1000X.Control</AssemblyName>
		<Product>SIGLENT SDG1000X Control</Product>
		<Description>Sterowanie generatorami SIGLENT serii SDG1000X przez LAN/VXI-11</Description>
		<PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
		<ApplicationIcon>../../sdg1062x.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(LabStationEmbed)' != 'true'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<DebugType>embedded</DebugType>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../Sdg1032X.Core/Sdg1032X.Core.csproj" />
		<ProjectReference Include="../../../Shared/LabStation.Instruments/LabStation.Instruments.csproj" />
		<ProjectReference Include="../../../Shared/LabStation.UI/LabStation.UI.csproj" />
		<Resource Include="../../sdg1062x.ico" Link="Assets/sdg1062x.ico" />
		<Content Include="../../sdg1062x.png" Link="ReferenceAssets/sdg1062x.png" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="../../README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="../../docs/hardware-testing.md" Link="docs/hardware-testing.md" CopyToPublishDirectory="PreserveNewest" />
		<EmbeddedResource Include="../../LICENSE" LogicalName="Sdg1032X.LICENSE" />
		<Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(LabStationEmbed)' == 'true'">
		<ApplicationDefinition Remove="App.xaml" />
		<Compile Remove="App.xaml.cs" />
		<Content Update="@(Content)" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
	</ItemGroup>
</Project>
