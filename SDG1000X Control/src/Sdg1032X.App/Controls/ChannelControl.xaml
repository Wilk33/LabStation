<UserControl
	x:Class="Sdg1032X.App.Controls.ChannelControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sharedControls="clr-namespace:LabStation.UI.Controls;assembly=LabStation.UI"
	Background="{StaticResource LabStationBackgroundBrush}"
	Foreground="{StaticResource LabStationTextBrush}">
	<Grid Margin="10,8">
		<Grid.RowDefinitions>
			<RowDefinition Height="38" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Button
			x:Name="OutputButton"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			Click="OutputClick"
			Content="OFF"
			Foreground="{StaticResource LabStationTextBrush}" />
		<TabControl
			x:Name="WaveformTabs"
			Grid.Row="1"
			Style="{StaticResource LabStationChannelTabControlStyle}">
			<TabControl.ItemsPanel>
				<ItemsPanelTemplate>
					<UniformGrid Rows="1" Columns="2" />
				</ItemsPanelTemplate>
			</TabControl.ItemsPanel>
			<TabItem
				Header="Przebieg"
				Style="{StaticResource LabStationChannelTabItemStyle}"
				Tag="#FF50E1E6">
				<ScrollViewer
					HorizontalScrollBarVisibility="Disabled"
					VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="8">
			<ComboBox
				x:Name="WaveformSelector"
				Margin="0,0,0,7"
				DisplayMemberPath="Name"
				SelectionChanged="WaveformSelectionChanged" />
			<sharedControls:NumericValueEditor
				x:Name="FrequencyEditor"
				Label="Częstotliwość"
				Unit="Hz"
				Step="1"
				Minimum="0.000001"
				Maximum="30000000"
				DecimalPlaces="3"
				ValueCommitted="FrequencyCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="AmplitudeEditor"
				Label="Amplituda"
				Unit="Vpp"
				Step="0.1"
				Minimum="0"
				Maximum="20"
				DecimalPlaces="3"
				ValueCommitted="AmplitudeCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="OffsetEditor"
				Label="Offset"
				Unit="V"
				Step="0.1"
				Minimum="-20"
				Maximum="20"
				DecimalPlaces="3"
				ValueCommitted="OffsetCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="PhaseEditor"
				Label="Faza"
				Unit="°"
				Step="1"
				Minimum="0"
				Maximum="360"
				DecimalPlaces="1"
				ValueCommitted="PhaseCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="DutyEditor"
				Label="Wypełnienie"
				Unit="%"
				Step="1"
				Minimum="0"
				Maximum="100"
				DecimalPlaces="1"
				ValueCommitted="DutyCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="SymmetryEditor"
				Label="Symetria"
				Unit="%"
				Step="1"
				Minimum="0"
				Maximum="100"
				DecimalPlaces="1"
				ValueCommitted="SymmetryCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="PulseWidthEditor"
				Label="Szerokość impulsu"
				Unit="µs"
				Scale="0.000001"
				Step="0.000001"
				Minimum="0.000001"
				Maximum="1000"
				DecimalPlaces="3"
				ValueCommitted="PulseWidthCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="NoiseDeviationEditor"
				Label="Odchylenie standardowe"
				Unit="V"
				Step="0.1"
				Minimum="0"
				Maximum="20"
				DecimalPlaces="3"
				ValueCommitted="NoiseDeviationCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="NoiseMeanEditor"
				Label="Średnia"
				Unit="V"
				Step="0.1"
				Minimum="-20"
				Maximum="20"
				DecimalPlaces="3"
				ValueCommitted="NoiseMeanCommitted" />
			<sharedControls:NumericValueEditor
				x:Name="DcLevelEditor"
				Label="Poziom DC"
				Unit="V"
				Step="0.1"
				Minimum="-20"
				Maximum="20"
				DecimalPlaces="3"
				ValueCommitted="DcLevelCommitted" />
			<Grid Margin="0,7,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="10" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock
						Margin="0,0,0,3"
						Foreground="{StaticResource LabStationTextBrush}"
						FontSize="11"
						Text="Obciążenie" />
					<ComboBox
						x:Name="LoadSelector"
						SelectionChanged="LoadSelectionChanged">
						<ComboBoxItem Tag="HighImpedance">Hi-Z</ComboBoxItem>
						<ComboBoxItem Tag="Ohms50">50 Ω</ComboBoxItem>
					</ComboBox>
				</StackPanel>
				<StackPanel Grid.Column="2">
					<TextBlock
						Margin="0,0,0,3"
						Foreground="{StaticResource LabStationTextBrush}"
						FontSize="11"
						Text="Polaryzacja" />
					<ComboBox
						x:Name="PolaritySelector"
						SelectionChanged="PolaritySelectionChanged">
						<ComboBoxItem Tag="Normal">Normalna</ComboBoxItem>
						<ComboBoxItem Tag="Inverted">Odwrócona</ComboBoxItem>
					</ComboBox>
				</StackPanel>
			</Grid>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem
				Header="Własny"
				Style="{StaticResource LabStationChannelTabItemStyle}"
				Tag="#FF50E1E6">
				<Grid Margin="8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox
							x:Name="CustomWaveformPathEditor"
							VerticalContentAlignment="Center" />
						<Button
							x:Name="BrowseCustomWaveformButton"
							Grid.Column="1"
							Margin="6,0,0,0"
							Click="BrowseCustomWaveformClick"
							ToolTip="Wybierz plik">
							<TextBlock Text="📁" />
						</Button>
					</Grid>
					<Button
						x:Name="LoadCustomWaveformButton"
						Grid.Row="1"
						Margin="0,8,0,0"
						HorizontalAlignment="Right"
						Click="LoadCustomWaveformClick"
						Content="Wczytaj" />
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>
