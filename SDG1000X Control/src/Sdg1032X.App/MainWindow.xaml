<Window
	x:Class="Sdg1032X.App.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="clr-namespace:Sdg1032X.App"
	xmlns:sharedControls="clr-namespace:LabStation.UI.Controls;assembly=LabStation.UI"
	Title="Siglent SDG1000X Control"
	Width="350"
	Height="675"
	Icon="/Siglent.SDG1000X.Control;component/Assets/sdg1062x.ico"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen">
	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem x:Name="NetworkToolsMenu" Header="Narzędzia">
				<MenuItem
					x:Name="ScanNetworkMenuItem"
					Header="Skanuj sieć"
					Click="ScanNetworkClick" />
				<Separator />
				<MenuItem
					x:Name="AutoConnectMenuItem"
					Header="Auto connect"
					IsCheckable="True"
					Click="AutoConnectClick" />
			</MenuItem>
			<sharedControls:AboutMenuItem Presentation="{x:Static local:ProductInformation.Presentation}" />
		</Menu>
		<local:GeneratorView x:Name="InstrumentPanel" />
	</DockPanel>
</Window>
