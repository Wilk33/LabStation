<Application
	
x:Class="Sdg1032X.App.App"
	
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	
StartupUri="MainWindow.xaml">
	
<Application.Resources>
	
	
<ResourceDictionary>
	
	
	
<ResourceDictionary.MergedDictionaries>
	
	
	
	
<ResourceDictionary Source="pack://application:,,,/LabStation.UI;component/Themes/LabStationTheme.xaml" />
	
	
	
</ResourceDictionary.MergedDictionaries>
	
	
	
<SolidColorBrush x:Key="WindowBrush" Color="{StaticResource LabStationBackground}" />
	
	
	
<SolidColorBrush x:Key="ControlBrush" Color="{StaticResource LabStationInput}" />
	
	
	
<SolidColorBrush x:Key="TextBrush" Color="{StaticResource LabStationText}" />
	
	
	
<SolidColorBrush x:Key="MutedTextBrush" Color="#C8C8C8" />
	
	
</ResourceDictionary>
	
</Application.Resources>
</Application>
