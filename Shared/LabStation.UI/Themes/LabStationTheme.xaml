<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
	<Color x:Key="LabStationBackground">#686868</Color>
	<Color x:Key="LabStationInput">#858585</Color>
	<Color x:Key="LabStationText">#FFFFFF</Color>
	<Color x:Key="LabStationOffline">#808000</Color>
	<Color x:Key="LabStationOff">#800000</Color>
	<Color x:Key="LabStationOn">#008000</Color>
	<Color x:Key="LabStationOnActive">#00FF00</Color>
	<SolidColorBrush x:Key="LabStationBackgroundBrush" Color="{StaticResource LabStationBackground}" />
	<SolidColorBrush x:Key="LabStationInputBrush" Color="{StaticResource LabStationInput}" />
	<SolidColorBrush x:Key="LabStationTextBrush" Color="{StaticResource LabStationText}" />
	<SolidColorBrush x:Key="LabStationOfflineBrush" Color="{StaticResource LabStationOffline}" />
	<SolidColorBrush x:Key="LabStationOffBrush" Color="{StaticResource LabStationOff}" />
	<SolidColorBrush x:Key="LabStationOnBrush" Color="{StaticResource LabStationOn}" />
	<SolidColorBrush x:Key="LabStationOnActiveBrush" Color="{StaticResource LabStationOnActive}" />
	<SolidColorBrush x:Key="LabStationMutedTextBrush" Color="#E0E0E0" />
	<SolidColorBrush x:Key="KoradBackgroundBrush" Color="{StaticResource LabStationBackground}" />
	<SolidColorBrush x:Key="KoradInputBrush" Color="{StaticResource LabStationInput}" />
	<SolidColorBrush x:Key="KoradTextBrush" Color="{StaticResource LabStationText}" />
	<SolidColorBrush x:Key="KoradOfflineBrush" Color="{StaticResource LabStationOffline}" />
	<SolidColorBrush x:Key="KoradOffBrush" Color="{StaticResource LabStationOff}" />
	<SolidColorBrush x:Key="KoradOnBrush" Color="{StaticResource LabStationOn}" />
	<SolidColorBrush x:Key="KoradOnActiveBrush" Color="{StaticResource LabStationOnActive}" />
	<SolidColorBrush x:Key="SystemChromeBackgroundBrush" Color="#F0F0F0" />
	<SolidColorBrush x:Key="SystemChromeForegroundBrush" Color="#000000" />
	<SolidColorBrush x:Key="SystemChromeHoverBrush" Color="#DADADA" />
	<SolidColorBrush x:Key="SystemChromeDisabledBrush" Color="#707070" />
	<SolidColorBrush x:Key="SystemChromeBorderBrush" Color="#808080" />
	<SolidColorBrush x:Key="SystemChromeSeparatorBrush" Color="#BEBEBE" />
	<BooleanToVisibilityConverter x:Key="LabStationBooleanToVisibilityConverter" />

	<Style TargetType="Window">
		<Setter Property="Background" Value="{StaticResource LabStationBackgroundBrush}" />
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
	</Style>

	<Style x:Key="LabStationButtonBaseStyle" TargetType="primitives:ButtonBase">
		<Setter Property="Margin" Value="3" />
		<Setter Property="Padding" Value="7,2" />
		<Setter Property="MinHeight" Value="28" />
		<Setter Property="Background" Value="{StaticResource LabStationInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="BorderBrush" Value="#303030" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="primitives:ButtonBase">
					<Border
						x:Name="OuterBorder"
						Background="#303030"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="1">
						<Border
							x:Name="ButtonBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="#C4C4C4"
							BorderThickness="1,1,0,0">
							<ContentPresenter
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ButtonBorder" Property="Background" Value="#949494" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="ButtonBorder" Property="Background" Value="#565656" />
							<Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#303030" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="ButtonBorder" Property="Background" Value="#747474" />
							<Setter Property="Foreground" Value="#D0D0D0" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="KoradButtonBaseStyle" TargetType="primitives:ButtonBase" BasedOn="{StaticResource LabStationButtonBaseStyle}" />
	<Style x:Key="LabStationButtonStyle" TargetType="Button" BasedOn="{StaticResource LabStationButtonBaseStyle}">
		<Setter Property="MinWidth" Value="72" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style x:Key="LabStationCursorButtonStyle" TargetType="Button" BasedOn="{StaticResource LabStationButtonStyle}">
		<Setter Property="Width" Value="76" />
		<Setter Property="Margin" Value="4,3,0,3" />
		<Setter Property="Padding" Value="5,2" />
		<Setter Property="Foreground" Value="White" />
	</Style>
	<Style TargetType="Button" BasedOn="{StaticResource LabStationButtonStyle}" />
	<Style TargetType="RepeatButton" BasedOn="{StaticResource LabStationButtonBaseStyle}">
		<Setter Property="Margin" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="0" />
	</Style>

	<Style TargetType="TextBox">
		<Setter Property="Background" Value="{StaticResource LabStationInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="CaretBrush" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="SelectionBrush" Value="#5B7694" />
		<Setter Property="BorderBrush" Value="#303030" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style TargetType="CheckBox">
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="4,0" />
	</Style>

	<Style TargetType="ComboBox">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="Background" Value="{StaticResource LabStationInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="BorderBrush" Value="#303030" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="MinHeight" Value="28" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<Border
							x:Name="ComboBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="22" />
								</Grid.ColumnDefinitions>
								<ContentPresenter
									Margin="{TemplateBinding Padding}"
									VerticalAlignment="Center"
									Content="{TemplateBinding SelectionBoxItem}"
									ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
								<Border Grid.Column="1" BorderBrush="#C4C4C4" BorderThickness="1,0,0,0">
									<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="▼" />
								</Border>
							</Grid>
						</Border>
						<ToggleButton
							Focusable="False"
							IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
							<ToggleButton.Template>
								<ControlTemplate TargetType="ToggleButton">
									<Border Background="Transparent" />
								</ControlTemplate>
							</ToggleButton.Template>
						</ToggleButton>
						<Popup
							Width="{TemplateBinding ActualWidth}"
							AllowsTransparency="True"
							IsOpen="{TemplateBinding IsDropDownOpen}"
							Placement="Bottom"
							PopupAnimation="None">
							<Border
								Background="{StaticResource LabStationInputBrush}"
								BorderBrush="#303030"
								BorderThickness="1">
								<ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
									<StackPanel IsItemsHost="True" />
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ComboBorder" Property="Background" Value="#909090" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="ComboBorder" Property="Background" Value="#747474" />
							<Setter Property="Foreground" Value="#D0D0D0" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="ComboBoxItem">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Background" Value="{StaticResource LabStationInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="Padding" Value="4,3" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="#A0A0A0" />
			</Trigger>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="#5B7694" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<ControlTemplate x:Key="LabStationTopLevelMenuItemTemplate" TargetType="MenuItem">
		<Grid>
			<Border
				x:Name="HeaderBorder"
				Background="{TemplateBinding Background}"
				Padding="{TemplateBinding Padding}"
				SnapsToDevicePixels="True">
				<ContentPresenter
					VerticalAlignment="Center"
					ContentSource="Header"
					RecognizesAccessKey="True" />
			</Border>
			<Popup
				x:Name="PART_Popup"
				AllowsTransparency="True"
				Focusable="False"
				IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}"
				Placement="Bottom"
				PopupAnimation="None">
				<Border
					Background="{DynamicResource SystemChromeBackgroundBrush}"
					BorderThickness="0"
					Padding="0">
					<ScrollViewer
						CanContentScroll="True"
						HorizontalScrollBarVisibility="Disabled"
						VerticalScrollBarVisibility="Auto">
						<ItemsPresenter
							Grid.IsSharedSizeScope="True"
							KeyboardNavigation.DirectionalNavigation="Cycle"
							SnapsToDevicePixels="True" />
					</ScrollViewer>
				</Border>
			</Popup>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsHighlighted" Value="True">
				<Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SystemChromeHoverBrush}" />
			</Trigger>
			<Trigger Property="IsSubmenuOpen" Value="True">
				<Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SystemChromeHoverBrush}" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource SystemChromeDisabledBrush}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<ControlTemplate x:Key="LabStationSubmenuMenuItemTemplate" TargetType="MenuItem">
		<Grid
			x:Name="ItemRoot"
			MinWidth="138"
			Background="{TemplateBinding Background}"
			SnapsToDevicePixels="True">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="22" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="18" />
			</Grid.ColumnDefinitions>
			<TextBlock
				x:Name="CheckMark"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				FontFamily="Segoe UI Symbol"
				FontSize="13"
				Foreground="{DynamicResource SystemChromeForegroundBrush}"
				Text="✓"
				Visibility="Collapsed" />
			<ContentPresenter
				Grid.Column="1"
				Margin="4,3,12,3"
				VerticalAlignment="Center"
				ContentSource="Header"
				RecognizesAccessKey="True" />
			<TextBlock
				x:Name="SubmenuArrow"
				Grid.Column="2"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				FontSize="10"
				Text="▶"
				Visibility="Collapsed" />
			<Popup
				x:Name="PART_Popup"
				AllowsTransparency="True"
				Focusable="False"
				HorizontalOffset="-2"
				IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}"
				Placement="Right"
				PopupAnimation="None">
				<Border
					Background="{DynamicResource SystemChromeBackgroundBrush}"
					BorderThickness="0"
					Padding="0">
					<ScrollViewer
						CanContentScroll="True"
						HorizontalScrollBarVisibility="Disabled"
						VerticalScrollBarVisibility="Auto">
						<ItemsPresenter
							Grid.IsSharedSizeScope="True"
							KeyboardNavigation.DirectionalNavigation="Cycle"
							SnapsToDevicePixels="True" />
					</ScrollViewer>
				</Border>
			</Popup>
		</Grid>
		<ControlTemplate.Triggers>
			<Trigger Property="IsChecked" Value="True">
				<Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
			</Trigger>
			<Trigger Property="Role" Value="SubmenuHeader">
				<Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
			</Trigger>
			<Trigger Property="IsHighlighted" Value="True">
				<Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource SystemChromeHoverBrush}" />
			</Trigger>
			<Trigger Property="IsSubmenuOpen" Value="True">
				<Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource SystemChromeHoverBrush}" />
			</Trigger>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource SystemChromeDisabledBrush}" />
			</Trigger>
		</ControlTemplate.Triggers>
	</ControlTemplate>

	<Style TargetType="Menu">
		<Setter Property="Background" Value="{DynamicResource SystemChromeBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource SystemChromeForegroundBrush}" />
		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Normal" />
	</Style>
	<Style TargetType="MenuItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource SystemChromeForegroundBrush}" />
		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Padding" Value="7,3" />
		<Setter Property="Template" Value="{StaticResource LabStationSubmenuMenuItemTemplate}" />
		<Style.Triggers>
			<Trigger Property="Role" Value="TopLevelHeader">
				<Setter Property="Template" Value="{StaticResource LabStationTopLevelMenuItemTemplate}" />
			</Trigger>
			<Trigger Property="Role" Value="TopLevelItem">
				<Setter Property="Template" Value="{StaticResource LabStationTopLevelMenuItemTemplate}" />
			</Trigger>
		</Style.Triggers>
	</Style>
	<Style TargetType="Separator">
		<Setter Property="Margin" Value="0,3" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Separator">
					<Grid Height="3" SnapsToDevicePixels="True">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="22" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="4" />
						</Grid.ColumnDefinitions>
						<Border
							Grid.Column="1"
							Height="1"
							VerticalAlignment="Center"
							Background="{DynamicResource SystemChromeSeparatorBrush}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="ToolBarTray">
		<Setter Property="Background" Value="{DynamicResource SystemChromeBackgroundBrush}" />
	</Style>
	<Style TargetType="ToolBar">
		<Setter Property="Background" Value="{DynamicResource SystemChromeBackgroundBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource SystemChromeForegroundBrush}" />
		<Setter Property="BorderThickness" Value="0" />
	</Style>

	<Style TargetType="TabControl">
		<Setter Property="Background" Value="{StaticResource LabStationBackgroundBrush}" />
		<Setter Property="BorderThickness" Value="0" />
	</Style>
	<Style x:Key="LabStationChannelTabControlStyle" TargetType="TabControl">
		<Setter Property="Background" Value="{StaticResource LabStationBackgroundBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TabControl">
					<Grid KeyboardNavigation.TabNavigation="Local">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<ItemsPresenter
							Grid.Row="0"
							HorizontalAlignment="Stretch"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						<Border
							Grid.Row="1"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter
								x:Name="PART_SelectedContentHost"
								ContentSource="SelectedContent"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
						</Border>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style TargetType="TabItem">
		<Setter Property="Background" Value="{StaticResource LabStationInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="Padding" Value="8,4" />
		<Setter Property="Margin" Value="0,0,2,0" />
	</Style>
	<Style x:Key="LabStationChannelTabItemStyle" TargetType="TabItem">
		<Setter Property="Background" Value="{StaticResource LabStationInputBrush}" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Padding" Value="8,4" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TabItem">
					<Border
						x:Name="HeaderBorder"
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="#303030"
						BorderThickness="1">
						<ContentPresenter
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center"
							ContentSource="Header"
							RecognizesAccessKey="True" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsSelected" Value="True">
							<Setter Property="Background" Value="{Binding Tag,RelativeSource={RelativeSource Self}}" />
							<Setter Property="Foreground" Value="Black" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="ValueTextStyle" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="26" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
	</Style>
	<Style x:Key="LabStationStatusPanelStyle" TargetType="Border">
		<Setter Property="Padding" Value="7,5" />
		<Setter Property="Background" Value="{StaticResource LabStationBackgroundBrush}" />
	</Style>
	<Style x:Key="LabStationStatusTextStyle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource LabStationTextBrush}" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding HasStatusError}" Value="True">
				<Setter Property="Foreground" Value="#FFFF8080" />
			</DataTrigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
