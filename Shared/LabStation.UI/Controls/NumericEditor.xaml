<UserControl
	x:Class="LabStation.UI.Controls.NumericEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Name="Root"
	Focusable="True">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="34" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="42" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="0,1,0,0"
			FontFamily="Consolas"
			FontSize="12"
			Text="{Binding Label,ElementName=Root}" />
		<DockPanel Grid.Row="0" Height="30" VerticalAlignment="Center">
			<TextBlock
				DockPanel.Dock="Right"
				Margin="4,0"
				VerticalAlignment="Center"
				FontFamily="Consolas"
				FontSize="22"
				Text="{Binding Unit,ElementName=Root}" />
			<TextBox
				Height="30"
				Padding="2,-1,2,0"
				BorderThickness="0"
				FontSize="24"
				HorizontalContentAlignment="Right"
				PreviewKeyDown="TextBoxPreviewKeyDown"
				Text="{Binding Text,ElementName=Root,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
		</DockPanel>
		<Grid Grid.Row="0" Grid.Column="1" Height="42" VerticalAlignment="Center">
			<Grid.RowDefinitions>
				<RowDefinition Height="21" />
				<RowDefinition Height="21" />
			</Grid.RowDefinitions>
			<RepeatButton
				Grid.Row="0"
				Margin="2,0,0,1"
				Padding="0"
				MinHeight="0"
				FontSize="11"
				Delay="350"
				Interval="60"
				Command="{Binding IncrementCommand,ElementName=Root}"
				Content="▲" />
			<RepeatButton
				Grid.Row="1"
				Margin="2,1,0,0"
				Padding="0"
				MinHeight="0"
				FontSize="11"
				Delay="350"
				Interval="60"
				Command="{Binding DecrementCommand,ElementName=Root}"
				Content="▼" />
		</Grid>
	</Grid>
</UserControl>
