<Window
	x:Class="LabStation.UI.Windows.LicenseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Background="{StaticResource LabStationBackgroundBrush}"
	Foreground="{StaticResource LabStationTextBrush}"
	FontFamily="Consolas"
	Width="720"
	Height="560"
	MinWidth="520"
	MinHeight="360"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">
	<Grid Background="{StaticResource LabStationBackgroundBrush}">
		<TextBox
			x:Name="LicenseText"
			Margin="14"
			Padding="10"
			Background="{StaticResource LabStationInputBrush}"
			Foreground="{StaticResource LabStationTextBrush}"
			FontFamily="Consolas"
			FontSize="13"
			HorizontalScrollBarVisibility="Auto"
			IsReadOnly="True"
			TextWrapping="Wrap"
			VerticalScrollBarVisibility="Auto" />
	</Grid>
</Window>
