<Window
	x:Class="LabStation.UI.Windows.AuthorWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Background="{StaticResource LabStationBackgroundBrush}"
	Foreground="{StaticResource LabStationTextBrush}"
	FontFamily="Consolas"
	Width="430"
	Height="190"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">
	<Grid Margin="22" Background="{StaticResource LabStationBackgroundBrush}">
		<StackPanel VerticalAlignment="Center">
			<TextBlock
				HorizontalAlignment="Center"
				FontSize="22"
				Text="{Binding AuthorName}" />
			<TextBlock
				Margin="0,8,0,0"
				HorizontalAlignment="Center"
				FontSize="16"
				Text="{Binding AuthorProfession}" />
			<TextBlock
				Margin="0,8,0,0"
				HorizontalAlignment="Center"
				FontSize="16"
				Text="{Binding AuthorEmail}" />
		</StackPanel>
	</Grid>
</Window>
