<Window
	x:Class="Ka3005P.App.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:viewModels="clr-namespace:Ka3005P.App.ViewModels"
	xmlns:views="clr-namespace:Ka3005P.App.Views"
	Title="Korad"
	Icon="/Korad.KA3005P;component/Assets/KoradS.ico"
	Background="{StaticResource KoradBackgroundBrush}"
	Foreground="{StaticResource KoradTextBrush}"
	Width="{Binding WindowWidth}"
	Height="{Binding WindowHeight}"
	MinWidth="{Binding WindowWidth}"
	MaxWidth="{Binding WindowWidth}"
	MinHeight="{Binding WindowHeight}"
	MaxHeight="{Binding WindowHeight}"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<DataTemplate DataType="{x:Type viewModels:SingleSupplyViewModel}">
			<views:SingleSupplyView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type viewModels:DualSupplyViewModel}">
			<views:DualSupplyView />
		</DataTemplate>
	</Window.Resources>
	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Tryb pracy">
				<MenuItem
					x:Name="SingleModeItem"
					Header="Pojedynczy"
					IsCheckable="True"
					IsChecked="{Binding IsSingleSelected,Mode=OneWay}"
					Click="SelectSingleClick" />
				<MenuItem
					x:Name="DualModeItem"
					Header="Dual"
					IsCheckable="True"
					IsChecked="{Binding IsDualSelected,Mode=OneWay}"
					Click="SelectDualClick" />
			</MenuItem>
			<MenuItem Header="Wykres" Click="OpenChartClick" />
			<MenuItem Header="Zapisz jako">
				<MenuItem Header="Napięcie CSV" Click="SaveVoltageClick" />
				<MenuItem Header="Prąd CSV" Click="SaveCurrentClick" />
				<MenuItem Header="Napięcie i prąd CSV" Click="SaveVoltageAndCurrentClick" />
			</MenuItem>
			<MenuItem Header="O aplikacji">
				<MenuItem Header="Autor" Click="OpenAuthorClick" />
				<MenuItem Header="Licencja" Click="OpenLicenseClick" />
			</MenuItem>
		</Menu>
		<ContentControl Content="{Binding CurrentMode}" />
	</DockPanel>
</Window>
