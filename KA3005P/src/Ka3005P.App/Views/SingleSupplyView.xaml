<UserControl
	x:Class="Ka3005P.App.Views.SingleSupplyView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:LabStation.UI.Controls;assembly=LabStation.UI"
	Background="{StaticResource KoradBackgroundBrush}"
	Foreground="{StaticResource KoradTextBrush}">
	<Grid Margin="18,12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Orientation="Horizontal">
				<TextBlock Margin="0,3,6,0" VerticalAlignment="Center" FontSize="17" Text="Port:" />
				<ComboBox
					Width="88"
					Height="28"
					VerticalAlignment="Center"
					IsEditable="False"
					IsEnabled="{Binding CanSelectPort}"
					ItemsSource="{Binding AvailablePorts}"
					SelectedItem="{Binding SelectedPort,Mode=TwoWay}" />
			</StackPanel>
			<Button Grid.Column="1" Command="{Binding ConnectCommand}" Content="{Binding ConnectionStatus}" />
		</Grid>
		<controls:NumericEditor Grid.Row="1" Margin="0,9,0,0" Label="Max napięcie zasilacza to 31V" Unit="V"
			Text="{Binding VoltageText,Mode=TwoWay}" IncrementCommand="{Binding IncrementVoltageCommand}"
			DecrementCommand="{Binding DecrementVoltageCommand}" CommitCommand="{Binding CommitVoltageCommand}" />
		<controls:NumericEditor Grid.Row="2" Margin="0,6,0,0" Label="Max prąd zasilacza to 5,1A" Unit="A"
			Text="{Binding CurrentText,Mode=TwoWay}" IncrementCommand="{Binding IncrementCurrentCommand}"
			DecrementCommand="{Binding DecrementCurrentCommand}" CommitCommand="{Binding CommitCurrentCommand}" />
		<Grid Grid.Row="3" Margin="0,6,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<controls:EngineeringStepSelector
				x:Name="StepMultiplierSelector"
				Grid.Column="1"
				Width="64"
				Margin="0,3,2,3"
				VisibleMultipliers="1,m"
				MultiplierChanged="StepMultiplierChanged" />
			<Button x:Name="OutputButton" Grid.Column="2" Width="72" Command="{Binding ToggleOutputCommand}" Content="{Binding OutputButtonText}" />
		</Grid>
		<Grid Grid.Row="4" Grid.RowSpan="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid>
				<TextBlock
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="17"
					Text="{Binding ResistanceText}" />
				<Border
					HorizontalAlignment="Left"
					VerticalAlignment="Bottom"
					Style="{StaticResource LabStationStatusPanelStyle}">
					<TextBlock
						Style="{StaticResource LabStationStatusTextStyle}"
						Text="{Binding StatusText}"
						ToolTip="{Binding ErrorMessage}" />
				</Border>
			</Grid>
			<StackPanel Grid.Column="1">
				<TextBlock
					HorizontalAlignment="Right"
					Style="{StaticResource ValueTextStyle}"
					Text="{Binding MeasuredVoltageText}" />
				<TextBlock
					HorizontalAlignment="Right"
					Style="{StaticResource ValueTextStyle}"
					Text="{Binding MeasuredCurrentText}" />
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
